---
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const navItems = [
  { i18n: 'nav.research', href: '/' },
  { i18n: 'nav.news', href: '/news' },
  { i18n: 'nav.blog', href: '/blog' },
  { i18n: 'nav.about', href: '/about' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-logo" aria-label="Home">
      <span class="site-logo__mark" aria-hidden="true"></span>
      <span>STUDIO</span>
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav" data-nav-toggle>
      <span data-i18n="nav.research">菜单</span>
    </button>

    <nav id="primary-nav" class="nav" aria-label="Primary">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} data-i18n={item.i18n}>
              {item.i18n.replace('nav.', '').replace(/^\w/, (c) => c.toUpperCase())}
            </a>
          </li>
        ))}
      </ul>

      <div class="nav-actions">
        <button class="lang-toggle" data-lang-toggle aria-label="切换语言">EN</button>
        <a href="/contact" class="btn btn--primary nav-cta" data-i18n="cta.contact">
          Get in touch
          <span class="btn__caret" aria-hidden="true">▾</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .lang-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    padding: 7px 10px;
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    background: transparent;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-text);
    transition: background-color 120ms ease;
  }

  .lang-toggle:hover {
    background-color: var(--color-bg-alt);
  }

  @media (max-width: 880px) {
    .nav-actions .btn--primary {
      display: none;
    }
    .nav--open .nav-actions {
      display: flex;
      position: absolute;
      top: 100%;
      right: var(--gutter);
      margin-top: 8px;
    }
    .nav--open .nav-actions .btn--primary {
      display: inline-flex;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const header = document.querySelector<HTMLElement>('.site-header');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    header?.classList.toggle('nav--open', !expanded);
  });
</script>