---
import Layout from '../layouts/Layout.astro';
import { getPostGroups, fmtZh, fmtEn } from '../lib/posts';

const posts = await getPostGroups();
const linkOf = (g: (typeof posts)[number]) => `/posts/${g.base}`;
---

<Layout title="出版物 — Studio" description="Studio 全部研究、技术报告与现场研究的归档。">
  <div class="container">
    <header class="page-hero" style="padding-block: var(--space-6) var(--space-5);">
      <h1 class="page-hero__title" data-i18n="pub.title" style="font-size: clamp(48px, 7vw, 88px);">出版物</h1>
      <div>
        <p class="page-hero__lede" data-i18n="pub.lede">
          The full archive of research, technical reports, and field studies from Studio.
        </p>
      </div>
    </header>

    <div class="publications-header">
      <p style="margin:0; color: var(--color-text-muted); font-size: 14px;">
        <span data-lang="zh">{posts.length} 篇出版物</span>
        <span data-lang="en">{posts.length} publications</span>
      </p>

      <label class="search-input">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <input
          type="search"
          id="publication-search"
          placeholder="搜索"
          data-i18n="pub.search"
          aria-label="搜索出版物"
          autocomplete="off"
        />
      </label>
    </div>

    <div class="publications-layout">
      <table class="publications-table" id="publications-table">
        <thead>
          <tr>
            <th scope="col"><span data-lang="zh">日期</span><span data-lang="en">Date</span></th>
            <th scope="col"><span data-lang="zh">分类</span><span data-lang="en">Category</span></th>
            <th scope="col"><span data-lang="zh">标题</span><span data-lang="en">Title</span></th>
          </tr>
        </thead>
        <tbody>
          {posts.map((g) => {
            const zh = g.zh!;
            const en = g.en!;
            const search = `${zh.data.title} ${en.data.title} ${zh.data.summary} ${en.data.summary}`.toLowerCase();
            return (
              <tr data-search={search}>
                <td>
                  <span data-lang="zh">{fmtZh(zh.data.publishDate)}</span>
                  <span data-lang="en">{fmtEn(zh.data.publishDate)}</span>
                </td>
                <td>
                  <span data-lang="zh">{zh.data.category}</span>
                  <span data-lang="en">{en.data.category}</span>
                </td>
                <td>
                  <a href={linkOf(g)}>
                    <span data-lang="zh">{zh.data.title}</span>
                    <span data-lang="en">{en.data.title}</span>
                  </a>
                </td>
              </tr>
            );
          })}
        </tbody>
        <tfoot>
          <tr id="publications-empty" hidden>
            <td colspan="3" class="publications-empty" data-i18n="pub.empty">
              没有匹配的出版物。
            </td>
          </tr>
        </tfoot>
      </table>

      <aside class="publications-side" aria-hidden="true">
        <span data-lang="zh">特色空间</span>
        <span data-lang="en">Featured space</span>
      </aside>
    </div>
  </div>

  <script>
    const input = document.getElementById('publication-search') as HTMLInputElement | null;
    const table = document.getElementById('publications-table');
    const emptyRow = document.getElementById('publications-empty');

    if (input && table && emptyRow) {
      const rows = Array.from(table.querySelectorAll<HTMLTableRowElement>('tbody tr'));

      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        let visible = 0;

        for (const row of rows) {
          const haystack = row.dataset.search ?? '';
          const match = !q || haystack.includes(q);
          row.hidden = !match;
          if (match) visible++;
        }

        emptyRow.hidden = visible !== 0;
      });
    }
  </script>
</Layout>